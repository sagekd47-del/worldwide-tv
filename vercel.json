{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/home.html" },
    { "source": "/player", "destination": "/player.html" },
    { "source": "/ai", "destination": "/savagetech-ai.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs24.x",
      "maxDuration": 60
    }
  }
}
